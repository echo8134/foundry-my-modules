<div class="safety-body">
  {{#if (or card signals door)}}
  <div class="safety-signals" role="group" aria-label="{{localize 'MY_MODULES.Safety.signals.Title'}}">
    {{#if card}}
    <button type="button" data-action="sendCard" data-tooltip="MY_MODULES.Safety.Send">
      <i class="fa-solid fa-pause" aria-hidden="true"></i>{{localize "MY_MODULES.Safety.signals.pause.Label"}}
    </button>
    {{/if}}
    {{#each signals}}
    <button type="button" data-action="signal" data-signal="{{@key}}" data-tooltip="MY_MODULES.Safety.signals.{{@key}}.Message">
      <i class="fa-solid {{this}}" aria-hidden="true"></i>{{localize (concat "MY_MODULES.Safety.signals." @key ".Label")}}
    </button>
    {{/each}}
    {{#if door}}
    <button type="button" data-action="openDoor">
      <i class="fa-solid fa-door-open" aria-hidden="true"></i>{{localize "MY_MODULES.Safety.BreakLabel"}}
      <small>{{localize "MY_MODULES.Safety.Named"}}</small>
    </button>
    {{/if}}
  </div>
  {{/if}}
  {{#if card}}
  <details data-sync="card">
    <summary>{{localize "MY_MODULES.Safety.Card"}}</summary>
    <div class="safety-prompt">
      <span class="safety-symbol" aria-hidden="true">X</span>
      <h2>{{localize "MY_MODULES.Safety.Prompt"}}</h2>
    </div>
    <label for="safety-note">{{localize "MY_MODULES.Safety.Note"}}</label>
    <input id="safety-note" type="text" maxlength="200" autocomplete="off">
    <p class="safety-hint">{{localize "MY_MODULES.Safety.Privacy"}}</p>
    {{#if notes}}
    <h3>{{localize "MY_MODULES.Safety.SessionNotes"}}</h3>
    <ul id="my-safety-session-notes">
      {{#each notes}}<li>{{this}}</li>{{/each}}
    </ul>
    {{/if}}
  </details>
  {{/if}}
  {{#if limits}}
  <details data-sync="limits">
    <summary>{{localize "MY_MODULES.Safety.Limits"}}</summary>
    <div class="safety-columns">
      {{#each columns}}
      <section data-kind="{{kind}}">
        <h2>{{localize title}}</h2><p class="safety-hint">{{localize hint}}</p>
        <div class="safety-add">
          <input id="safety-add-{{kind}}" type="text" maxlength="200" aria-label="{{localize add}}" placeholder="{{localize add}}" autocomplete="off">
          <button type="button" class="icon fa-solid fa-plus" data-action="addEntry" aria-label="{{localize add}}" data-tooltip="{{add}}"></button>
        </div>
        <ul>
          {{#each entries}}
          <li data-entry="{{id}}">
            {{#if @root.gm}}
            <input type="text" id="safety-entry-{{id}}" maxlength="200" aria-label="{{localize 'MY_MODULES.Safety.Edit'}}" value="{{text}}">
            <button type="button" class="icon fa-solid fa-check" data-action="editEntry" aria-label="{{localize 'MY_MODULES.Safety.Save'}}" data-tooltip="MY_MODULES.Safety.Save"></button>
            <button type="button" class="icon fa-solid fa-trash" data-action="removeEntry" aria-label="{{localize 'MY_MODULES.Safety.Remove'}}" data-tooltip="MY_MODULES.Safety.Remove"></button>
            {{else}}{{text}}{{/if}}
          </li>
          {{/each}}
        </ul>
      </section>
      {{/each}}
    </div>
    <p class="safety-hint">{{localize "MY_MODULES.Safety.Privacy"}}</p>
  </details>
  {{/if}}
</div>
