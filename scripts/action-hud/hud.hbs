<div class="hud-body" data-actor="{{actor.uuid}}">
  {{#if actor}}
  {{#if effects.length}}
  <section class="hud-effects" aria-label="{{localize 'MY_MODULES.ActionHud.activeEffects'}}">
    {{#each effects}}
    <button type="button" data-effect-uuid="{{uuid}}" {{#if concentrating}}data-action="endConcentration"{{/if}} aria-label="{{name}}" aria-description="{{tooltip}}" data-tooltip-text="{{tooltip}}" data-tooltip-class="my-action-hud-effects">
      <img src="{{img}}" alt="">
    </button>
    {{/each}}
  </section>
  {{/if}}
  <nav class="hud-bar" aria-label="{{localize 'MY_MODULES.ActionHud.title'}}">
    <span class="hud-name{{#unless docked}} hud-grip{{/unless}}" {{#unless docked}}title="{{localize 'MY_MODULES.ActionHud.move'}}"{{/unless}}>
      {{#unless docked}}<i class="fa-solid fa-grip-vertical" inert></i>{{/unless}}
      <span>{{actor.name}}</span>
    </span>
    {{#each groups}}
    <button type="button" id="my-action-group-{{id}}" data-action="group" data-group="{{id}}" aria-expanded="{{#if (eq id ../open.id)}}true{{else}}false{{/if}}">
      <i class="fa-solid {{icon}}" inert></i><span>{{localize label}}</span>
    </button>
    {{/each}}
    {{#if deathSave}}
    <button type="button" id="my-action-death-save" data-action="deathSave" data-tooltip aria-label="{{localize 'MY_MODULES.ActionHud.rollDeathSave'}}">
      <i class="fa-solid fa-skull" inert></i>
    </button>
    {{/if}}
  </nav>
  {{#if open}}
  <section class="hud-panel" aria-label="{{localize open.label}}">
    <header><i class="fa-solid {{open.icon}}" inert></i>{{localize open.label}}</header>
    {{#each open.sections}}
    <div class="hud-section" data-level="{{level}}">
      {{#if label}}<h3>{{localize label}}{{#if slots}}<small>{{slots}}</small>{{/if}}</h3>{{/if}}
      <div class="hud-entries">
      {{#each entries}}
        <button type="button" id="my-action-{{action}}-{{id}}" data-action="{{action}}" data-id="{{id}}" {{#if (eq action "condition")}}aria-pressed="{{active}}"{{/if}} {{#if tooltip}}data-tooltip-text="{{tooltip}}" data-tooltip-class="my-action-hud-activities" aria-description="{{tooltip}}"{{/if}}>
          {{#if img}}<img src="{{img}}" alt="">{{/if}}
          <span>{{name}}</span>
          {{#if summary}}<small>{{summary}}</small>{{/if}}
          {{#if detail}}<small>{{detail}}</small>{{/if}}
          {{#if active}}<i class="fa-solid fa-check" inert></i>{{/if}}
        </button>
      {{/each}}
      </div>
    </div>
    {{/each}}
  </section>
  {{/if}}
  {{/if}}
</div>
